  </main>

  <footer class="pie">
    <p>
      <svg class="pie__icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.6 8 12 11.7 5.4 8 12 4.3ZM5 9.7l6 3.4v6.6l-6-3.3V9.7Zm8 10v-6.6l6-3.4v6.7l-6 3.3Z"/></svg>
      <% if (entorno === 'kubernetes') { %>
        Servido desde el pod <code><%= pod.nombre %></code> en el nodo <code><%= pod.nodo %></code>
      <% } else { %>
        Servido desde el contenedor <code><%= contenedor %></code>
      <% } %>
    </p>
    <p>
      Versión <strong><%= version %></strong> ·
      Node.js · Express · MySQL · <%= entorno === 'kubernetes' ? plataforma : 'Docker Compose' %>
    </p>
  </footer>
</body>
</html>
